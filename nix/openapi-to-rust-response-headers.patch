#
# Extracted from the sibling checkout ~/Code/openapi-to-rust (uncommitted
# work on top of upstream main): src/analysis.rs, src/client_generator.rs,
# src/server/codegen.rs. Regenerates the typed response header structs
# the sign-in endpoints rely on (see packages/api/README.md).
