{
  "openapi": "3.0.1",
  "info": {
    "title": "Samples",
    "version": "1.0.0",
    "description": "Example service definition to demonstrate the features of OpenAPI"
  },
  "paths": {
    "/api": {
      "get": {
        "operationId": "serveSpec",
        "description": "Serve openapi spec",
        "tags": ["codegen"],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "A response that contains openapi json",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/samples": {
      "get": {
        "operationId": "getSamples",
        "description": "Gets samples method",
        "tags": ["codegen"],
        "parameters": [
          { "$ref": "#/components/parameters/offset" },
          { "$ref": "#/components/parameters/limit" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/samples" }
        }
      },
      "post": {
        "operationId": "createSample",
        "description": "Creates a sample",
        "tags": ["codegen"],
        "requestBody": {
          "description": "The new sample",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/newSample"
              },
              "example": {
                "description": "example sample description",
                "imageUri": "https://example.com/example.png",
                "name": "sample",
                "status": "ACTIVE",
                "tags": ["sample"]
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/sample" }
        }
      }
    },
    "/api/samples/{sampleId}": {
      "parameters": [
        {
          "name": "sampleId",
          "description": "A sample ID",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 5,
            "maxLength": 36,
            "example": "01a09e49-eef3-74cb-a86f-5ea209c1f923"
          }
        }
      ],
      "get": {
        "operationId": "getSample",
        "description": "Gets a sample",
        "tags": ["codegen"],
        "responses": {
          "200": { "$ref": "#/components/responses/sample" },
          "404": { "$ref": "#/components/responses/sample" }
        }
      },
      "patch": {
        "operationId": "updateSample",
        "description": "Updates a sample",
        "tags": ["codegen"],
        "requestBody": {
          "description": "The sample update",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/sampleUpdate"
              },
              "example": {
                "description": "example sample description updated",
                "imageUri": "https://example.com/example-updated.png",
                "name": "sample updated",
                "status": "INACTIVE",
                "tags": ["sample", "updated"]
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/sample" },
          "404": { "$ref": "#/components/responses/sample" }
        }
      },
      "delete": {
        "operationId": "removeSample",
        "description": "Removes a sample",
        "tags": ["codegen"],
        "responses": {
          "200": { "$ref": "#/components/responses/sample" },
          "404": { "$ref": "#/components/responses/sample" }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "operationId": "register",
        "description": "Create an account with a username and password, and sign in",
        "tags": ["codegen"],
        "requestBody": {
          "description": "The new account's credentials",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/credentials"
              },
              "example": {
                "username": "alice",
                "password": "correct horse battery"
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/sessionCreated"
          },
          "409": {
            "$ref": "#/components/responses/session"
          },
          "500": {
            "$ref": "#/components/responses/session"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "operationId": "login",
        "description": "Sign in with a username and password",
        "tags": ["codegen"],
        "requestBody": {
          "description": "The account's credentials",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/credentials"
              },
              "example": {
                "username": "alice",
                "password": "correct horse battery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/sessionCreated"
          },
          "401": {
            "$ref": "#/components/responses/session"
          },
          "500": {
            "$ref": "#/components/responses/session"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "logout",
        "description": "Clear the session cookie. Tokens are stateless, so a bearer token stays valid until it expires; clients using one should discard it",
        "tags": ["codegen"],
        "responses": {
          "204": {
            "$ref": "#/components/responses/signedOut"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "getAccount",
        "description": "The account the bearer token belongs to",
        "tags": ["codegen"],
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/authorization"
          },
          {
            "$ref": "#/components/parameters/sessionCookie"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/account"
          },
          "401": {
            "$ref": "#/components/responses/account"
          },
          "500": {
            "$ref": "#/components/responses/account"
          }
        }
      }
    },
    "/api/auth/passkeys/register/options": {
      "post": {
        "operationId": "startPasskeyRegistration",
        "description": "WebAuthn creation options for adding a passkey to the signed-in account",
        "tags": ["codegen"],
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/authorization"
          },
          {
            "$ref": "#/components/parameters/sessionCookie"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/passkeyChallenge"
          },
          "401": {
            "$ref": "#/components/responses/passkeyChallenge"
          },
          "500": {
            "$ref": "#/components/responses/passkeyChallenge"
          }
        }
      }
    },
    "/api/auth/passkeys/register": {
      "post": {
        "operationId": "finishPasskeyRegistration",
        "description": "Verify a new passkey and store it on the signed-in account",
        "tags": ["codegen"],
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/authorization"
          },
          {
            "$ref": "#/components/parameters/sessionCookie"
          }
        ],
        "requestBody": {
          "description": "The ceremony token and the authenticator's attestation",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/passkeyCredential"
              },
              "example": {
                "ceremony": "eyJhbGciOiJIUzI1NiJ9…",
                "credential": {}
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/account"
          },
          "400": {
            "$ref": "#/components/responses/account"
          },
          "401": {
            "$ref": "#/components/responses/account"
          },
          "500": {
            "$ref": "#/components/responses/account"
          }
        }
      }
    },
    "/api/auth/passkeys/login/options": {
      "post": {
        "operationId": "startPasskeyLogin",
        "description": "WebAuthn request options for signing in with one of an account's passkeys",
        "tags": ["codegen"],
        "requestBody": {
          "description": "The account to sign in to",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/passkeyLogin"
              },
              "example": {
                "username": "alice"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/passkeyChallenge"
          },
          "400": {
            "$ref": "#/components/responses/passkeyChallenge"
          },
          "500": {
            "$ref": "#/components/responses/passkeyChallenge"
          }
        }
      }
    },
    "/api/auth/passkeys/login": {
      "post": {
        "operationId": "finishPasskeyLogin",
        "description": "Verify a passkey assertion and sign in",
        "tags": ["codegen"],
        "requestBody": {
          "description": "The ceremony token and the authenticator's assertion",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/passkeyCredential"
              },
              "example": {
                "ceremony": "eyJhbGciOiJIUzI1NiJ9…",
                "credential": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/sessionCreated"
          },
          "400": {
            "$ref": "#/components/responses/session"
          },
          "401": {
            "$ref": "#/components/responses/session"
          },
          "500": {
            "$ref": "#/components/responses/session"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "offset": {
        "name": "offset",
        "description": "The number of items to skip before returning the first item",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "limit": {
        "name": "limit",
        "description": "The maximum number of items to return",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100
        }
      },
      "sessionCookie": {
        "name": "__Host-session",
        "description": "Session token set by a sign-in response; an alternative to the `Authorization` header",
        "in": "cookie",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "authorization": {
        "name": "Authorization",
        "description": "`Bearer <token>`, using the token from a sign-in response",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 4096
        },
        "example": "Bearer eyJhbGciOiJIUzI1NiJ9…"
      }
    },
    "responses": {
      "sample": {
        "description": "success",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "description": "A response that contains a single sample",
              "required": ["errors"],
              "properties": {
                "data": {
                  "$ref": "#/components/schemas/sample"
                },
                "type": {
                  "description": "The HTTP status code applicable as a description string.",
                  "type": "string"
                },
                "code": {
                  "description": "The HTTP status code applicable as a description string.",
                  "type": "string"
                },
                "status": {
                  "description": "The HTTP status code applicable.",
                  "type": "integer"
                },
                "title": {
                  "description": "A short, human-readable summary that SHOULD NOT change from occurrence to occurrence, except for purposes of localization.",
                  "type": "string"
                },
                "errors": {
                  "type": "array",
                  "description": "Any errors produced during method execution",
                  "items": {
                    "$ref": "#/components/schemas/error"
                  }
                }
              }
            }
          }
        }
      },
      "samples": {
        "description": "success",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "description": "A response that contains a single sample",
              "required": ["data", "errors"],
              "properties": {
                "data": {
                  "type": "array",
                  "description": "Any errors produced during method execution",
                  "items": {
                    "$ref": "#/components/schemas/sample"
                  }
                },
                "type": {
                  "description": "The HTTP status code applicable as a description string.",
                  "type": "string"
                },
                "code": {
                  "description": "The HTTP status code applicable as a description string.",
                  "type": "string"
                },
                "status": {
                  "description": "The HTTP status code applicable.",
                  "type": "integer"
                },
                "title": {
                  "description": "A short, human-readable summary that SHOULD NOT change from occurrence to occurrence, except for purposes of localization.",
                  "type": "string"
                },
                "errors": {
                  "type": "array",
                  "description": "Any errors produced during method execution",
                  "items": {
                    "$ref": "#/components/schemas/error"
                  }
                }
              }
            }
          }
        }
      },
      "account": {
        "description": "A response that contains the signed-in account",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "description": "A response that contains the signed-in account",
              "required": ["errors"],
              "properties": {
                "data": {
                  "$ref": "#/components/schemas/account"
                },
                "type": {
                  "description": "The HTTP status code applicable as a description string.",
                  "type": "string"
                },
                "code": {
                  "description": "The HTTP status code applicable as a description string.",
                  "type": "string"
                },
                "status": {
                  "description": "The HTTP status code applicable.",
                  "type": "integer"
                },
                "title": {
                  "description": "A short, human-readable summary that SHOULD NOT change from occurrence to occurrence, except for purposes of localization.",
                  "type": "string"
                },
                "errors": {
                  "type": "array",
                  "description": "Any errors produced during method execution",
                  "items": {
                    "$ref": "#/components/schemas/error"
                  }
                }
              }
            }
          }
        }
      },
      "session": {
        "description": "A response that contains a bearer token and its account",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "description": "A response that contains a bearer token and its account",
              "required": ["errors"],
              "properties": {
                "data": {
                  "$ref": "#/components/schemas/session"
                },
                "type": {
                  "description": "The HTTP status code applicable as a description string.",
                  "type": "string"
                },
                "code": {
                  "description": "The HTTP status code applicable as a description string.",
                  "type": "string"
                },
                "status": {
                  "description": "The HTTP status code applicable.",
                  "type": "integer"
                },
                "title": {
                  "description": "A short, human-readable summary that SHOULD NOT change from occurrence to occurrence, except for purposes of localization.",
                  "type": "string"
                },
                "errors": {
                  "type": "array",
                  "description": "Any errors produced during method execution",
                  "items": {
                    "$ref": "#/components/schemas/error"
                  }
                }
              }
            }
          }
        }
      },
      "sessionCreated": {
        "description": "A response that contains a bearer token and its account, and sets the session cookie",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "description": "A response that contains a bearer token and its account, and sets the session cookie",
              "required": ["errors"],
              "properties": {
                "data": {
                  "$ref": "#/components/schemas/session"
                },
                "type": {
                  "description": "The HTTP status code applicable as a description string.",
                  "type": "string"
                },
                "code": {
                  "description": "The HTTP status code applicable as a description string.",
                  "type": "string"
                },
                "status": {
                  "description": "The HTTP status code applicable.",
                  "type": "integer"
                },
                "title": {
                  "description": "A short, human-readable summary that SHOULD NOT change from occurrence to occurrence, except for purposes of localization.",
                  "type": "string"
                },
                "errors": {
                  "type": "array",
                  "description": "Any errors produced during method execution",
                  "items": {
                    "$ref": "#/components/schemas/error"
                  }
                }
              }
            }
          }
        },
        "headers": {
          "Set-Cookie": {
            "$ref": "#/components/headers/sessionCookie"
          }
        }
      },
      "signedOut": {
        "description": "The session cookie was cleared",
        "headers": {
          "Set-Cookie": {
            "$ref": "#/components/headers/sessionCookie"
          }
        }
      },
      "passkeyChallenge": {
        "description": "A response that contains WebAuthn options for the browser",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "description": "A response that contains WebAuthn options for the browser",
              "required": ["errors"],
              "properties": {
                "data": {
                  "$ref": "#/components/schemas/passkeyChallenge"
                },
                "type": {
                  "description": "The HTTP status code applicable as a description string.",
                  "type": "string"
                },
                "code": {
                  "description": "The HTTP status code applicable as a description string.",
                  "type": "string"
                },
                "status": {
                  "description": "The HTTP status code applicable.",
                  "type": "integer"
                },
                "title": {
                  "description": "A short, human-readable summary that SHOULD NOT change from occurrence to occurrence, except for purposes of localization.",
                  "type": "string"
                },
                "errors": {
                  "type": "array",
                  "description": "Any errors produced during method execution",
                  "items": {
                    "$ref": "#/components/schemas/error"
                  }
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "errorCode": {
        "description": "An application-specific error code, expressed as a string value",
        "type": "string",
        "enum": [
          "BAD_PARAMETER",
          "BAD_REQUEST",
          "CONFLICT",
          "FORBIDDEN",
          "INTERNAL_SERVER_ERROR",
          "INVALID_RESPONSE",
          "METHOD_NOT_ALLOWED",
          "NOT_FOUND",
          "UNAUTHORIZED"
        ]
      },
      "error": {
        "type": "object",
        "description": "A standard error",
        "required": ["id", "code", "status", "title"],
        "properties": {
          "id": {
            "description": "A unique identifier for this particular occurrence of the problem.",
            "type": "string"
          },
          "code": { "$ref": "#/components/schemas/errorCode" },
          "status": {
            "description": "The HTTP status code applicable to this problem.",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem that SHOULD NOT change from occurrence to occurrence of the problem, except for purposes of localization.",
            "type": "string"
          },
          "message": {
            "description": "a human-readable explanation specific to this occurrence of the problem. Like `title`, this field’s value can be localized.",
            "type": "string"
          },
          "location": {
            "description": "where this occured, example the path of the route responding or function",
            "type": "string"
          },
          "source": {
            "type": "object",
            "description": "An object containing references to the source of the error",
            "properties": {
              "pointer": {
                "description": "A JSON Pointer (RFC6901) to the associated entity in the request document (e.g. `/data` for a primary data object, or `/data/attributes/title` for a specific attribute).",
                "type": "string"
              },
              "parameter": {
                "description": "A string indicating which method parameter caused the error.",
                "type": "string"
              }
            }
          }
        }
      },
      "status": {
        "type": "string",
        "enum": ["ACTIVE", "INACTIVE", "ARCHIVED"],
        "description": "Current state of a sample"
      },
      "sample": {
        "type": "object",
        "description": "A sample entity representing a generic resource",
        "required": ["id", "name", "status", "createdAt"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique, non-sequential identifier for this sample"
          },
          "name": {
            "type": "string",
            "description": "Descriptive name for the sample",
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "description": "A longer description of the sample",
            "maxLength": 2000
          },
          "status": { "$ref": "#/components/schemas/status" },
          "tags": {
            "type": "array",
            "maxItems": 25,
            "items": {
              "type": "string",
              "maxLength": 100
            },
            "description": "Tags associated with the sample"
          },
          "tagsCondensed": {
            "type": "string",
            "description": "A regional comma separated string of the tags",
            "maxLength": 2500
          },
          "imageUri": {
            "type": "string",
            "description": "Absolute URI to an image representing the sample",
            "maxLength": 500
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the sample was created"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the sample was last updated"
          }
        }
      },
      "sampleUpdate": {
        "type": "object",
        "description": "A sample entity representing a generic resource",
        "properties": {
          "name": {
            "type": "string",
            "description": "Descriptive name for the sample",
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "description": "A longer description of the sample",
            "maxLength": 2000
          },
          "status": { "$ref": "#/components/schemas/status" },
          "tags": {
            "type": "array",
            "maxItems": 25,
            "items": {
              "type": "string",
              "maxLength": 100
            },
            "description": "Tags associated with the sample"
          },
          "imageUri": {
            "type": "string",
            "description": "Absolute URI to an image representing the sample",
            "maxLength": 500
          }
        }
      },
      "newSample": {
        "type": "object",
        "description": "A sample entity representing a generic resource",
        "required": ["name", "status"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Descriptive name for the sample",
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "description": "A longer description of the sample",
            "maxLength": 2000
          },
          "status": { "$ref": "#/components/schemas/status" },
          "tags": {
            "type": "array",
            "maxItems": 25,
            "items": {
              "type": "string",
              "maxLength": 100
            },
            "description": "Tags associated with the sample"
          },
          "imageUri": {
            "type": "string",
            "description": "Absolute URI to an image representing the sample",
            "maxLength": 500
          }
        }
      },
      "credentials": {
        "type": "object",
        "description": "A username and password",
        "required": ["username", "password"],
        "properties": {
          "username": {
            "type": "string",
            "description": "3–32 letters, digits, '.', '_' or '-'; case-insensitive",
            "pattern": "^[A-Za-z0-9._-]{3,32}$"
          },
          "password": {
            "type": "string",
            "description": "8–256 characters",
            "minLength": 8,
            "maxLength": 256
          }
        }
      },
      "passkeyLogin": {
        "type": "object",
        "description": "The account to sign in to with a passkey",
        "required": ["username"],
        "properties": {
          "username": {
            "type": "string",
            "description": "3–32 letters, digits, '.', '_' or '-'; case-insensitive",
            "pattern": "^[A-Za-z0-9._-]{3,32}$"
          }
        }
      },
      "account": {
        "type": "object",
        "description": "A user account",
        "required": ["id", "username", "passkeys"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier of the account"
          },
          "username": {
            "type": "string",
            "description": "Lowercased username"
          },
          "passkeys": {
            "type": "integer",
            "description": "Number of registered passkeys"
          }
        }
      },
      "session": {
        "type": "object",
        "description": "A signed, stateless bearer token for an account",
        "required": ["token", "expiresAt", "account"],
        "properties": {
          "token": {
            "type": "string",
            "description": "Send as `Authorization: Bearer <token>`"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the token stops being accepted"
          },
          "account": {
            "$ref": "#/components/schemas/account"
          }
        }
      },
      "passkeyChallenge": {
        "type": "object",
        "description": "The first half of a passkey ceremony",
        "required": ["ceremony", "options"],
        "properties": {
          "ceremony": {
            "type": "string",
            "description": "Signed ceremony state; send it back unchanged with the credential"
          },
          "options": {
            "type": "object",
            "description": "WebAuthn options for `navigator.credentials.create()` / `.get()`",
            "additionalProperties": true
          }
        }
      },
      "passkeyCredential": {
        "type": "object",
        "description": "The second half of a passkey ceremony",
        "required": ["ceremony", "credential"],
        "properties": {
          "ceremony": {
            "type": "string",
            "description": "The `ceremony` from the matching options response",
            "maxLength": 16384
          },
          "credential": {
            "type": "object",
            "description": "The `PublicKeyCredential` from the browser, binary fields base64url-encoded",
            "additionalProperties": true
          }
        }
      }
    },
    "headers": {
      "sessionCookie": {
        "description": "`__Host-session=<token>; Path=/; HttpOnly; Secure; SameSite=Lax` with a `Max-Age` matching the token, or `Max-Age=0` to clear it",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-session"
      }
    }
  }
}
